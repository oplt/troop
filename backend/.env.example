APP_NAME=fullstack-app
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORE_DOMAIN_SINGULAR=Project
CORE_DOMAIN_PLURAL=Projects
PLATFORM_DEFAULT_MODULE_PACK=full_platform

DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app_db
# SQLAlchemy async pool (per API/worker process). Total DB connections ≈ processes × (POOL_SIZE + MAX_OVERFLOW).
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_TIMEOUT_SECONDS=30
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=true
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_EMAIL_QUEUE=email
# Optional Redis queue names for split workers (GitHub / model gateway / observability). See docs/deployment/celery-service-queues.md
CELERY_QUEUE_GITHUB=github
CELERY_QUEUE_MODEL_GATEWAY=model_gateway
CELERY_QUEUE_OBSERVABILITY=observability
CELERY_RESULT_EXPIRES_SECONDS=3600
# Celery beat (run a dedicated `celery -A backend.workers.celery_app:celery_app beat` process):
# - provider health checks, GitHub issue poll fallback, daily memory expiration sweep
PROVIDER_HEALTHCHECK_INTERVAL_MINUTES=5
GITHUB_ISSUE_POLL_INTERVAL_MINUTES=15
# 0 = disabled. Dev server (APP_ENV=dev) skips this limiter entirely. Use a sane cap in staging/prod.
ORCHESTRATION_RUN_RATE_LIMIT_PER_MINUTE=120
ORCHESTRATION_SLA_SCAN_INTERVAL_MINUTES=20
# When false, intra-provider model fallback (primary + fallback_model chain) is disabled.
ORCHESTRATION_PROVIDER_FAILOVER=true
# When true, worker execute_run routes run modes through LangGraph (see docs/adr/0004-*.md).
ORCHESTRATION_USE_LANGGRAPH=false
# Durable queue label for ops/UI (only "celery" is implemented; temporal is future).
ORCHESTRATION_DURABLE_QUEUE_BACKEND=celery
# Production defaults to requiring Docker for code_execute CPU jobs (host fallback blocked).
ORCHESTRATION_CPU_REQUIRE_DOCKER=
ORCHESTRATION_CPU_JOB_TIMEOUT_SECONDS=
AGENT_TOKEN_BUDGET_WINDOW_DAYS=30

JWT_SECRET=replace-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_SIGNUP_INVITE_CODE=
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
PUBLIC_RATE_LIMIT_REQUESTS=120
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_FAILURE_LIMIT=8
AUTH_FAILURE_WINDOW_SECONDS=900
HEALTH_READY_PUBLIC=false
HEALTH_VERSION_PUBLIC=false
REQUIRE_EMAIL_VERIFICATION=true

VERIFICATION_TOKEN_TTL=86400
PASSWORD_RESET_TOKEN_TTL=3600

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=false

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
OTLP_ENDPOINT=
OTLP_INSECURE=true

STORAGE_BUCKET=app-assets
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=change-this-storage-access-key
STORAGE_SECRET_KEY=change-this-storage-secret-key
STORAGE_USE_SSL=false
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/app-assets
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_PUBLIC_READ=true
STORAGE_AVATAR_MAX_BYTES=5242880

# Orchestration platform notes:
# - provider and GitHub secrets are stored through the app UI, not as required env vars
# - keep CELERY_TASK_ALWAYS_EAGER=false when you want durable background execution
# - Redis and PostgreSQL remain required for orchestration runs and approvals
# - GitHub App webhooks: POST /webhooks/github (HMAC-SHA256 via X-Hub-Signature-256) — set GITHUB_APP_WEBHOOK_SECRET
# - pgvector: use Postgres image with pgvector (see infra/docker-compose.yml) for vector similarity on knowledge chunks

# AI memory layer (see docs/MEMORY_LAYER.md)
MEMORY_LAYER_ENABLED=true
MEMORY_PROVIDER=semantic_pgvector
MEMORY_DEFAULT_SEARCH_LIMIT=5
MEMORY_EXTRACTION_ENABLED=true
# Set true to use an LLM for memory extraction (higher quality, higher cost/latency).
# Leave false for fast rule-based extraction in dev; enable in production when quality matters.
MEMORY_LLM_EXTRACTION_ENABLED=false
MEMORY_DEDUP_ENABLED=true
MEMORY_MIN_EXTRACTION_CONFIDENCE=0.45
MEMORY_LOG_CONTENT_IN_DEV=false

# RAG layer (see docs/RAG_LAYER.md)
# RAG_EMBEDDING_PROVIDER empty → falls back to AI_EMBEDDING_PROVIDER (usually "local" in dev).
# RAG_EMBEDDING_MODEL empty → falls back to OPENAI_EMBEDDING_MODEL when provider is openai.
RAG_ENABLED=true
RAG_PROVIDER=native
RAG_VECTOR_STORE=pgvector
RAG_EMBEDDING_PROVIDER=
RAG_EMBEDDING_MODEL=
RAG_CHUNK_SIZE=0
RAG_CHUNK_OVERLAP=0
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.2
RAG_SCORE_THRESHOLD_LOCAL=0.05
RAG_RERANK_ENABLED=false
RAG_MAX_CONTEXT_TOKENS=4000
RAG_INDEXING_BATCH_SIZE=64
RAG_LOG_CONTENT_IN_DEV=false
RAG_CHUNK_FALLBACK_MAX=200
RAG_PYTHON_FALLBACK_ENABLED=false
AI_RETRIEVE_PYTHON_FALLBACK_ENABLED=false

# Query bounds (run events API, replay, chunk fallback scans)
RUN_EVENTS_DEFAULT_LIMIT=200
RUN_EVENTS_MAX_LIMIT=1000
RUN_EVENTS_REPLAY_MAX=2000
RUN_EVENTS_CLASSIFIER_MAX=400
RUN_EVENTS_EXPLAIN_MAX=500
AI_RETRIEVE_CHUNK_SCAN_MAX=500
ORCHESTRATION_LIST_TASKS_DEFAULT_LIMIT=500
ORCHESTRATION_LIST_TASKS_MAX_LIMIT=5000
ORCHESTRATION_LIST_RUNS_DEFAULT_LIMIT=500
ORCHESTRATION_LIST_RUNS_MAX_LIMIT=5000
ORCHESTRATION_LIST_DOCUMENTS_DEFAULT_LIMIT=200
ORCHESTRATION_LIST_DOCUMENTS_MAX_LIMIT=2000
RAG_ANSWER_TIMEOUT_SECONDS=90
RAG_BULK_INGEST_CONCURRENCY=4
MEMORY_INGEST_JOB_CONCURRENCY=3
AI_DOCUMENT_INGEST_ASYNC=true

# Redis caching (session validation, embeddings, RAG retrieval)
CACHE_ENABLED=true
CACHE_SESSION_TTL_SECONDS=60
CACHE_EMBEDDING_TTL_SECONDS=86400
CACHE_RAG_RETRIEVAL_TTL_SECONDS=300
CACHE_ACL_TTL_SECONDS=300
CACHE_ACL_DENIED_TTL_SECONDS=60
CACHE_PLATFORM_METADATA_TTL_SECONDS=1800
CACHE_MEMORY_SETTINGS_TTL_SECONDS=300
CACHE_HTTP_DOCUMENT_LIST_MAX_AGE_SECONDS=60
