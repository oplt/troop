APP_NAME=fullstack-app
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORE_DOMAIN_SINGULAR=Project
CORE_DOMAIN_PLURAL=Projects
PLATFORM_DEFAULT_MODULE_PACK=full_platform

DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app_db
# SQLAlchemy async pool (per process). Total DB connections ≈ processes × (POOL_SIZE + MAX_OVERFLOW).
# API processes use DATABASE_POOL_SIZE; Celery workers use *_WORKER (auto-detected via DATABASE_PROCESS_ROLE=auto).
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_SIZE_WORKER=5
DATABASE_MAX_OVERFLOW_WORKER=5
DATABASE_PROCESS_ROLE=auto
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_TIMEOUT_SECONDS=10
SCHEMA_COMPAT_CHECK_ON_STARTUP=true
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2.0
REDIS_SOCKET_TIMEOUT_SECONDS=5.0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=true
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_EMAIL_QUEUE=email
# Optional Redis queue names for split workers (GitHub / model gateway / observability). See docs/deployment/celery-service-queues.md
CELERY_QUEUE_GITHUB=github
CELERY_QUEUE_MODEL_GATEWAY=model_gateway
CELERY_QUEUE_OBSERVABILITY=observability
CELERY_QUEUE_INTEGRATIONS=integrations
CELERY_RESULT_EXPIRES_SECONDS=3600
# Celery beat (run a dedicated `celery -A backend.workers.celery_app:celery_app beat` process):
# - provider health checks, GitHub issue poll fallback, daily memory expiration sweep
PROVIDER_HEALTHCHECK_INTERVAL_MINUTES=5
GITHUB_ISSUE_POLL_INTERVAL_MINUTES=15
# 0 = disabled. Dev server (APP_ENV=dev) skips this limiter entirely. Use a sane cap in staging/prod.
ORCHESTRATION_RUN_RATE_LIMIT_PER_MINUTE=120
ORCHESTRATION_SLA_SCAN_INTERVAL_MINUTES=20
# When false, intra-provider model fallback (primary + fallback_model chain) is disabled.
ORCHESTRATION_PROVIDER_FAILOVER=true
# Durable queue label for ops/UI (only "celery" is implemented; temporal is future).
ORCHESTRATION_DURABLE_QUEUE_BACKEND=celery
# Max paid LLM HTTP attempts per routing purpose; provider chain capped separately.
ORCHESTRATION_LLM_ATTEMPT_BUDGET=3
ORCHESTRATION_PROVIDER_FAILOVER_MAX=2
# Mark in_progress runs older than this (seconds) as failed/recoverable.
ORCHESTRATION_STALE_IN_PROGRESS_SECONDS=3600
# Production defaults to requiring Docker for code_execute CPU jobs (host fallback blocked).
ORCHESTRATION_CPU_REQUIRE_DOCKER=
ORCHESTRATION_CPU_JOB_TIMEOUT_SECONDS=
AGENT_TOKEN_BUDGET_WINDOW_DAYS=30

JWT_SECRET=replace-me
# Optional Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# Required when APP_ENV=production. Legacy JWT-derived ciphertext still decrypts during migration.
SECRETS_ENCRYPTION_KEY=
# Optional prior Fernet key kept during rotation (see backend/tools/rotate_secrets_encryption.py).
SECRETS_ENCRYPTION_PREVIOUS_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:5173
PUBLIC_API_BASE=http://localhost:8000/api/v1
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_SIGNUP_INVITE_CODE=
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
PUBLIC_RATE_LIMIT_REQUESTS=120
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_FAILURE_LIMIT=8
AUTH_FAILURE_WINDOW_SECONDS=900
HEALTH_READY_PUBLIC=false
HEALTH_VERSION_PUBLIC=false
REQUIRE_EMAIL_VERIFICATION=true

VERIFICATION_TOKEN_TTL=86400
PASSWORD_RESET_TOKEN_TTL=3600

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=false

# Observability (see docs/CONFIGURATION.md and docs/OBSERVABILITY.md)
OBSERVABILITY_ENABLED=true
METRICS_ENABLED=true
METRICS_PUBLIC=false
METRICS_QUEUE_REFRESH_ENABLED=false
METRICS_REFRESH_TIMEOUT_SECONDS=0.5
HEALTH_READY_TIMEOUT_SECONDS=2.0
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
OTLP_ENDPOINT=
OTLP_INSECURE=true

STORAGE_BUCKET=app-assets
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=change-this-storage-access-key
STORAGE_SECRET_KEY=change-this-storage-secret-key
STORAGE_USE_SSL=false
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/app-assets
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_PUBLIC_READ=false
# Optional separate bucket for public avatars/branding. Primary bucket stays private.
STORAGE_PUBLIC_ASSET_BUCKET=
STORAGE_PRESIGNED_URL_TTL_SECONDS=3600
STORAGE_AVATAR_MAX_BYTES=5242880

# Orchestration platform notes:
# - provider and GitHub secrets are stored through the app UI, not as required env vars
# - keep CELERY_TASK_ALWAYS_EAGER=false when you want durable background execution
# - Redis and PostgreSQL remain required for orchestration runs and approvals
# - GitHub App webhooks: POST /webhooks/github (HMAC-SHA256 via X-Hub-Signature-256) — set GITHUB_APP_WEBHOOK_SECRET
# Native Gmail connector (authorization-code + PKCE). Keep secrets outside source control.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/workforce/connectors/gmail/callback
GOOGLE_PUBSUB_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=
# Production authenticated push (OIDC).
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Dev/test-only shared bearer fallback.
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
CONNECTOR_OAUTH_STATE_TTL_MINUTES=10
GMAIL_WATCH_RENEW_INTERVAL_MINUTES=60
GMAIL_WATCH_RENEW_BEFORE_HOURS=24

OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/workforce/connectors/outlook/callback
OUTLOOK_WEBHOOK_URL=http://localhost:8000/api/v1/workforce/webhooks/outlook
OUTLOOK_WEBHOOK_CLIENT_STATE=
OUTLOOK_SUBSCRIPTION_RENEW_INTERVAL_MINUTES=60
OUTLOOK_SUBSCRIPTION_RENEW_BEFORE_HOURS=24

GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/workforce/connectors/google_calendar/callback
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/workforce/connectors/google_drive/callback
MICROSOFT_CALENDAR_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/workforce/connectors/microsoft_calendar/callback
MICROSOFT_DRIVE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/workforce/connectors/microsoft_drive/callback
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_DRIVE_CLIENT_ID=
MICROSOFT_DRIVE_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/workforce/connectors/jira/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/workforce/connectors/linear/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/workforce/connectors/hubspot/callback
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/workforce/connectors/salesforce/callback

# Telegram Bot API webhook and one-time identity linking.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_BASE_URL=
# Telegram sends this in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_TTL_MINUTES=10
TELEGRAM_EDIT_TTL_MINUTES=15
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/workforce/connectors/slack/callback
SLACK_SIGNING_SECRET=
SLACK_LINK_TTL_MINUTES=10

TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/workforce/connectors/teams/callback
TEAMS_BOT_APP_ID=
TEAMS_LINK_TTL_MINUTES=10
EXTERNAL_WEBHOOK_MAX_BYTES=1000000
# - pgvector: use Postgres image with pgvector (see infra/docker-compose.yml) for vector similarity on knowledge chunks

# AI memory layer (see docs/MEMORY_LAYER.md)
MEMORY_LAYER_ENABLED=true
MEMORY_PROVIDER=semantic_pgvector
MEMORY_DEFAULT_SEARCH_LIMIT=5
MEMORY_EXTRACTION_ENABLED=true
# Set true to use an LLM for memory extraction (higher quality, higher cost/latency).
# Leave false for fast rule-based extraction in dev; enable in production when quality matters.
MEMORY_LLM_EXTRACTION_ENABLED=false
MEMORY_DEDUP_ENABLED=true
MEMORY_MIN_EXTRACTION_CONFIDENCE=0.45
MEMORY_LOG_CONTENT_IN_DEV=false

# RAG layer (see docs/RAG_LAYER.md)
# RAG_EMBEDDING_PROVIDER empty → falls back to AI_EMBEDDING_PROVIDER (usually "local" in dev).
# RAG_EMBEDDING_MODEL empty → falls back to OPENAI_EMBEDDING_MODEL when provider is openai.
RAG_ENABLED=true
RAG_PROVIDER=native
RAG_VECTOR_STORE=pgvector
RAG_EMBEDDING_PROVIDER=
RAG_EMBEDDING_MODEL=
RAG_CHUNK_SIZE=0
RAG_CHUNK_OVERLAP=0
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.2
RAG_SCORE_THRESHOLD_LOCAL=0.05
RAG_RERANK_ENABLED=false
RAG_MAX_CONTEXT_TOKENS=4000
RAG_INDEXING_BATCH_SIZE=64
FS_TOOL_MAX_READ_BYTES=262144
FS_TOOL_MAX_WRITE_BYTES=524288
GITHUB_INSTALLATION_TOKEN_SAFETY_MARGIN_SECONDS=300
RAG_LOG_CONTENT_IN_DEV=false
RAG_CHUNK_FALLBACK_MAX=200
# Python/JSON vector fallbacks — keep false in prod (see docs/CONFIGURATION.md).
RAG_PYTHON_FALLBACK_ENABLED=false
VECTOR_FALLBACK_JSON=false
# When false, document chunks store embedding_vector only (embedding_json written as []).
VECTOR_WRITE_EMBEDDING_JSON=false
PROJECT_DECISIONS_MERGE_LIMIT=300
AI_RETRIEVE_PYTHON_FALLBACK_ENABLED=false

# Query bounds (run events API, replay, chunk fallback scans)
RUN_EVENTS_DEFAULT_LIMIT=200
RUN_EVENTS_MAX_LIMIT=1000
RUN_EVENTS_REPLAY_MAX=2000
RUN_EVENTS_CLASSIFIER_MAX=400
RUN_EVENTS_EXPLAIN_MAX=500
AI_RETRIEVE_CHUNK_SCAN_MAX=500
ORCHESTRATION_LIST_TASKS_DEFAULT_LIMIT=500
ORCHESTRATION_LIST_TASKS_MAX_LIMIT=5000
ORCHESTRATION_LIST_RUNS_DEFAULT_LIMIT=50
ORCHESTRATION_LIST_RUNS_MAX_LIMIT=100
ORCHESTRATION_LIST_DOCUMENTS_DEFAULT_LIMIT=200
ORCHESTRATION_LIST_DOCUMENTS_MAX_LIMIT=2000
RAG_ANSWER_TIMEOUT_SECONDS=90
RAG_BULK_INGEST_CONCURRENCY=4
PARALLEL_READ_GROUP_MAX_CONCURRENCY=4
PARALLEL_READ_WORKSPACE_MAX_INFLIGHT=8
PARALLEL_READ_PROVIDER_MAX_INFLIGHT=4
MEMORY_INGEST_JOB_CONCURRENCY=3
AI_DOCUMENT_INGEST_ASYNC=true

# Redis caching (session validation, embeddings, RAG retrieval)
CACHE_ENABLED=true
CACHE_SESSION_TTL_SECONDS=60
CACHE_EMBEDDING_TTL_SECONDS=86400
CACHE_RAG_RETRIEVAL_TTL_SECONDS=300
CACHE_ACL_TTL_SECONDS=300
CACHE_ACL_DENIED_TTL_SECONDS=60
CACHE_PLATFORM_METADATA_TTL_SECONDS=1800
CACHE_MEMORY_SETTINGS_TTL_SECONDS=300
CACHE_HTTP_DOCUMENT_LIST_MAX_AGE_SECONDS=60
