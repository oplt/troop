POSTGRES_USER=app
POSTGRES_PASSWORD=change-this-local-db-password
POSTGRES_DB=app_db
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-local-minio-password

# Optional local observability overlay
METRICS_ENABLED=true
METRICS_PUBLIC=true
# Enable only on the API instance Prometheus scrapes for queue depth/age.
METRICS_QUEUE_REFRESH_ENABLED=true
INSTANCE_ID=local-api-1
OTLP_ENDPOINT=http://localhost:4317
